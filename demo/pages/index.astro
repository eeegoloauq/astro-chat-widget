---
/**
 * Demo page. The page itself plays the host site, and the widget on it is the
 * only instance: no recorded or looping previews. Answers come from the
 * browser-only mock SSE transport (../mock.ts). Run with `npm run demo`.
 *
 * The "Make it yours" controls set the same public tokens a site would set on
 * :root (--acw-color-scheme, --acw-accent, --acw-surface, --acw-blur) and print
 * that CSS. On wide screens the panel opens once per visit, beside the content;
 * on phones the widget's own button opens it.
 */
import AIChat from '../../src/AIChat.astro'
import { CHAT_ENDPOINT, FEEDBACK_ENDPOINT } from '../endpoints'
import { ARTICLES, CONTACT_URL, QUICK_REPLIES, STRINGS } from '../content'

const usage = `---
import { AIChat } from 'astro-chat-widget'
---
<AIChat
  endpoint="/api/chat"
  contactUrl="/contact"
  quickReplies={[{ text: 'Delivery options', answer: 'Courier **tomorrow**.' }]}
  articles={[{ title: 'Shipping and returns', href: '/help/shipping', minutes: 3 }]}
/>`
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content"
    />
    <!-- Same mark everywhere: favicon = docs/icon.svg (catalog avatar) — bubble + sparkle. -->
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 128 128'><defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'><stop offset='0' stop-color='%236b83ff'/><stop offset='1' stop-color='%234257e0'/></linearGradient></defs><rect width='128' height='128' rx='28' fill='url(%23g)'/><path d='M64 25c-24 0-43.5 16-43.5 35.7 0 11 6.1 20.9 15.6 27.4.2 5.6-1.6 11.6-5 16.5-1.1 1.6.2 3.7 2.1 3.4 9.2-1.4 17.2-5.3 22.8-9.9 2.6.4 5.3.6 8 .6 24 0 43.5-16 43.5-35.7S88 25 64 25z' fill='white'/><g fill='url(%23g)' transform='translate(41 37.7) scale(1.92)'><path d='M12 0c1.1 6.8 5.2 10.9 12 12-6.8 1.1-10.9 5.2-12 12-1.1-6.8-5.2-10.9-12-12C6.8 10.9 10.9 6.8 12 0z'/></g></svg>" />
    <title>astro-chat-widget</title>
    <meta name="description" content="A chat panel for Astro content sites: quick answers, guides and streamed AI answers." />
    <!-- Apply saved demo settings before first paint, so nothing flashes. -->
    <script is:inline>
      try {
        const s = JSON.parse(localStorage.getItem('acw-demo:settings') || '{}')
        const root = document.documentElement
        if (s.scheme === 'light' || s.scheme === 'dark') root.dataset.scheme = s.scheme
        if (typeof s.accent === 'string' && /^#[0-9a-f]{6}$/i.test(s.accent)) root.style.setProperty('--acw-accent', s.accent)
        if (s.surface === 'glass') root.dataset.surface = 'glass'
      } catch {}
    </script>
  </head>
  <body>
    <div class="page">
      <header class="top">
        <span class="brand">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 3C6.5 3 2 6.6 2 11c0 2.5 1.4 4.7 3.6 6.2 0 1.3-.4 2.7-1.2 3.8-.3.4 0 .9.5.8 2.1-.3 3.9-1.2 5.2-2.3.6.1 1.2.1 1.9.1 5.5 0 10-3.6 10-8S17.5 3 12 3z"/>
          </svg>
          astro-chat-widget
        </span>
        <nav class="links" aria-label="Project links">
      <a
        class="pill gh"
        href="https://github.com/eeegoloauq/astro-chat-widget"
        target="_blank"
        rel="noopener"
        aria-label="astro-chat-widget on GitHub"
      >
        <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
        </svg>
        GitHub
        <span class="count" hidden>
          <svg viewBox="0 0 16 16" width="13" height="13" fill="currentColor" aria-hidden="true">
            <path d="M8 .25a.75.75 0 0 1 .67.42l1.88 3.8 4.2.62c.61.09.86.84.41 1.28l-3.04 2.96.72 4.18a.75.75 0 0 1-1.09.79L8 12.35l-3.75 1.97a.75.75 0 0 1-1.09-.79l.72-4.18L.84 6.37a.75.75 0 0 1 .41-1.28l4.2-.61L7.33.67A.75.75 0 0 1 8 .25Z"/>
          </svg>
          <span data-count></span>
        </span>
      </a>
      <a
        class="pill npm"
        href="https://www.npmjs.com/package/astro-chat-widget"
        target="_blank"
        rel="noopener"
        aria-label="astro-chat-widget on npm"
        title="Weekly downloads on npm"
      >
        <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true">
          <path d="M1.763 0C.786 0 0 .786 0 1.763v20.474C0 23.214.786 24 1.763 24h20.474c.977 0 1.763-.786 1.763-1.763V1.763C24 .786 23.214 0 22.237 0zM5.13 5.323l13.837.019-.009 13.836h-3.464l.01-10.382h-3.456L12.04 19.17H5.113z"/>
        </svg>
        npm
        <span class="count" hidden>
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 4v11m0 0 5-5m-5 5-5-5M5 20h14"/>
          </svg>
          <span data-count></span>
        </span>
      </a>
        </nav>
      </header>

      <main>
        <section class="hero">
          <h1>A chat panel for Astro content sites</h1>
          <p class="lede">Quick answers, guides and streamed AI answers in one panel.</p>
          <button class="install" type="button" title="Copy to clipboard">
              <code>npm install astro-chat-widget</code>
              <svg class="install-copy" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="9" y="9" width="12" height="12" rx="2.5"/><path d="M5 15H4.5A1.5 1.5 0 0 1 3 13.5v-9A1.5 1.5 0 0 1 4.5 3h9A1.5 1.5 0 0 1 15 4.5V5"/>
              </svg>
              <svg class="install-check" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 12.5 9.5 18 20 6.5"/>
              </svg>
          </button>
        </section>

        <section class="block" aria-labelledby="try-title">
          <h2 id="try-title">Make it yours</h2>
          <form class="controls" id="controls">
            <fieldset>
              <legend>Theme</legend>
              <div class="seg">
                <input type="radio" name="scheme" id="scheme-system" value="system" checked /><label for="scheme-system">System</label>
                <input type="radio" name="scheme" id="scheme-light" value="light" /><label for="scheme-light">Light</label>
                <input type="radio" name="scheme" id="scheme-dark" value="dark" /><label for="scheme-dark">Dark</label>
              </div>
            </fieldset>
            <fieldset>
              <legend>Accent</legend>
              <div class="swatches">
                <input type="radio" name="accent" id="accent-indigo" value="#536dfe" checked /><label for="accent-indigo" style="--c: #536dfe"><span class="sr">Indigo</span></label>
                <input type="radio" name="accent" id="accent-red" value="#e31e24" /><label for="accent-red" style="--c: #e31e24"><span class="sr">Red</span></label>
                <input type="radio" name="accent" id="accent-teal" value="#0f8a7e" /><label for="accent-teal" style="--c: #0f8a7e"><span class="sr">Teal</span></label>
                <input type="radio" name="accent" id="accent-amber" value="#c2700a" /><label for="accent-amber" style="--c: #c2700a"><span class="sr">Amber</span></label>
              </div>
            </fieldset>
            <fieldset>
              <legend>Surface</legend>
              <div class="seg">
                <input type="radio" name="surface" id="surface-solid" value="solid" checked /><label for="surface-solid">Solid</label>
                <input type="radio" name="surface" id="surface-glass" value="glass" /><label for="surface-glass">Glass</label>
              </div>
            </fieldset>
          </form>
          <pre class="code"><code id="css-out">:root {
  /* defaults, nothing to set */
}</code></pre>
        </section>

        <section class="block" aria-labelledby="use-title">
          <h2 id="use-title">Add it to a page</h2>
          <pre class="code"><code>{usage}</code></pre>
        </section>

      </main>

    </div>

    <AIChat
      endpoint={CHAT_ENDPOINT}
      feedbackEndpoint={FEEDBACK_ENDPOINT}
      strings={STRINGS}
      quickReplies={QUICK_REPLIES}
      articles={ARTICLES}
      contactUrl={CONTACT_URL}
    />
  </body>
</html>

<script>
  import '../mock'

  // Live counts for the corner pills (GitHub stars, npm weekly downloads).
  // Both APIs are unauthenticated with per-visitor-IP quotas — a session
  // cache keeps reloads free. On any failure the pill stays a plain link;
  // the count is garnish.
  const compact = (n: number) => new Intl.NumberFormat('en', { notation: 'compact' }).format(n)
  async function liveCount(
    pill: string,
    key: string,
    url: string,
    pick: (data: any) => number,
    fmt: (n: number) => string
  ) {
    const wrap = document.querySelector<HTMLElement>(`${pill} .count`)
    const out = wrap?.querySelector<HTMLElement>('[data-count]')
    if (!wrap || !out) return
    try {
      const cached = JSON.parse(sessionStorage.getItem(key) || 'null')
      let n = cached && Date.now() - cached.t < 3_600_000 ? cached.n : null
      if (n === null) {
        const res = await fetch(url)
        if (!res.ok) return
        n = pick(await res.json())
        sessionStorage.setItem(key, JSON.stringify({ n, t: Date.now() }))
      }
      out.textContent = fmt(n)
      wrap.hidden = false
    } catch { /* plain link is fine */ }
  }
  liveCount(
    '.gh', 'acw:demo:stars',
    'https://api.github.com/repos/eeegoloauq/astro-chat-widget',
    (d) => d.stargazers_count, compact
  )
  liveCount(
    '.npm', 'acw:demo:downloads',
    'https://api.npmjs.org/downloads/point/last-week/astro-chat-widget',
    (d) => d.downloads, (n) => compact(n) + '/wk'
  )

  // Click-to-copy on the install command; the icon confirms instead of a toast.
  // navigator.clipboard exists only on https/localhost, so plain-http previews
  // (a phone on the LAN) fall back to a selected textarea + execCommand.
  async function copyText(text: string): Promise<boolean> {
    if (navigator.clipboard && window.isSecureContext) {
      try {
        await navigator.clipboard.writeText(text)
        return true
      } catch { /* fall through */ }
    }
    const scratch = document.createElement('textarea')
    scratch.value = text
    scratch.setAttribute('readonly', '')
    scratch.style.cssText = 'position:fixed;top:0;left:0;opacity:0'
    document.body.appendChild(scratch)
    scratch.select()
    scratch.setSelectionRange(0, text.length) // iOS ignores select() alone
    try {
      return document.execCommand('copy')
    } catch {
      return false
    } finally {
      scratch.remove()
    }
  }
  const install = document.querySelector<HTMLButtonElement>('.install')
  install?.addEventListener('click', async () => {
    if (!(await copyText('npm install astro-chat-widget'))) return
    install.classList.add('is-copied')
    window.setTimeout(() => install.classList.remove('is-copied'), 1600)
  })

  // ── "Make it yours": the same tokens a site would set ──────────────────
  type Settings = { scheme: 'system' | 'light' | 'dark'; accent: string; surface: 'solid' | 'glass' }
  const DEFAULTS: Settings = { scheme: 'system', accent: '#536dfe', surface: 'solid' }
  const SETTINGS_KEY = 'acw-demo:settings'
  const GLASS = {
    surface: 'light-dark(rgba(255, 255, 255, .7), rgba(22, 23, 28, .74))',
    blur: 'blur(22px) saturate(1.6)',
  }
  const root = document.documentElement
  const form = document.querySelector<HTMLFormElement>('#controls')!
  const out = document.querySelector<HTMLElement>('#css-out')!

  function read(): Settings {
    try {
      return { ...DEFAULTS, ...JSON.parse(localStorage.getItem(SETTINGS_KEY) || '{}') }
    } catch {
      return { ...DEFAULTS }
    }
  }

  function apply(s: Settings): void {
    if (s.scheme === 'system') delete root.dataset.scheme
    else root.dataset.scheme = s.scheme
    root.style.setProperty('--acw-accent', s.accent)
    if (s.surface === 'glass') {
      root.dataset.surface = 'glass'
      root.style.setProperty('--acw-surface', GLASS.surface)
      root.style.setProperty('--acw-blur', GLASS.blur)
    } else {
      delete root.dataset.surface
      root.style.removeProperty('--acw-surface')
      root.style.removeProperty('--acw-blur')
    }
    const lines: string[] = []
    if (s.accent !== DEFAULTS.accent) lines.push(`  --acw-accent: ${s.accent};`)
    if (s.scheme !== 'system') lines.push(`  --acw-color-scheme: ${s.scheme};`)
    if (s.surface === 'glass') lines.push(`  --acw-surface: ${GLASS.surface};`, `  --acw-blur: ${GLASS.blur};`)
    out.textContent = `:root {\n${lines.length ? lines.join('\n') : '  /* defaults, nothing to set */'}\n}`
    try { localStorage.setItem(SETTINGS_KEY, JSON.stringify(s)) } catch {}
  }

  const initial = read()
  for (const [name, value] of Object.entries(initial)) {
    const input = form.querySelector<HTMLInputElement>(`input[name="${name}"][value="${value}"]`)
    if (input) input.checked = true
  }
  apply(initial)
  form.addEventListener('change', () => {
    const data = new FormData(form)
    apply({
      scheme: data.get('scheme') as Settings['scheme'],
      accent: String(data.get('accent')),
      surface: data.get('surface') as Settings['surface'],
    })
  })

  // Wide screens have room for the panel beside the content: open it once per
  // visit so the product is visible without a click. Phones get the button.
  window.addEventListener('load', () => {
    if (!window.matchMedia('(min-width: 1100px)').matches) return
    try {
      if (sessionStorage.getItem('acw-demo:opened')) return
      sessionStorage.setItem('acw-demo:opened', '1')
    } catch { return }
    document.dispatchEvent(new CustomEvent('acw:ask'))
  })
</script>

<style>
  /* Page palette: light-dark() pairs follow color-scheme, which the Theme
     control pins through data-scheme (the widget follows --acw-color-scheme). */
  :root {
    color-scheme: light dark;
    --bg: light-dark(#f6f6f4, #0e0f13);
    --surface: light-dark(#ffffff, #16171c);
    --text: light-dark(#17181d, #ecedf1);
    --muted: light-dark(#5b5e6a, #a0a3ae);
    --line: light-dark(#e2e2e7, #262830);
    --code-bg: light-dark(#f0f0f2, #121318);
    --link: light-dark(#3a4fd6, #95a6ff);
  }
  :root[data-scheme='light'] { color-scheme: light; --acw-color-scheme: light; }
  :root[data-scheme='dark'] { color-scheme: dark; --acw-color-scheme: dark; }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 16px/1.6 ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  /* Glass needs something behind it: a soft accent wash on the right, where
     the panel sits. Only while glass is on. */
  :root[data-surface='glass'] body {
    background:
      radial-gradient(40rem 30rem at 92% 70%, color-mix(in srgb, var(--acw-accent, #536dfe) 30%, transparent), transparent 70%),
      var(--bg);
    background-attachment: fixed;
  }
  a { color: var(--link); text-underline-offset: 3px; }
  code, pre { font-family: ui-monospace, 'SFMono-Regular', Menlo, monospace; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  :focus-visible { outline: 2px solid var(--link); outline-offset: 2px; }

  /* Content column on the left; on wide screens the open panel sits to its right. */
  .page {
    max-width: 1180px;
    margin: 0 auto;
    padding-inline: max(20px, env(safe-area-inset-left, 0px)) max(20px, env(safe-area-inset-right, 0px));
  }
  main {
    max-width: 620px;
    display: flex;
    flex-direction: column;
    gap: 56px;
    padding-block: 40px 72px;
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 20px;
    padding-block: 18px;
    border-bottom: 1px solid var(--line);
  }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 650; letter-spacing: -0.01em; }
  .brand svg { color: var(--acw-accent, #536dfe); }
  .links { display: flex; flex-wrap: wrap; gap: 8px; }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--muted);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
  }
  .pill:hover { color: var(--text); border-color: var(--muted); }
  .count {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding-left: 8px;
    border-left: 1px solid var(--line);
    font-variant-numeric: tabular-nums;
  }

  h1 {
    margin: 0 0 14px;
    font-size: clamp(2rem, 5vw, 2.75rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  h2 { margin: 0 0 16px; font-size: 1.3rem; letter-spacing: -0.01em; }
  .lede { margin: 0 0 24px; font-size: 1.15rem; color: var(--muted); max-width: 34em; }

  .install {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    color: var(--muted);
    cursor: pointer;
  }
  .install code { font-size: 14px; color: var(--text); }
  .install code::before { content: '$ '; color: var(--muted); }
  .install:hover { border-color: var(--muted); }
  .install .install-check { display: none; color: #2f9e57; }
  .install.is-copied .install-copy { display: none; }
  .install.is-copied .install-check { display: block; }

  .controls { display: flex; flex-wrap: wrap; gap: 20px 32px; margin: 0 0 16px; }
  fieldset { margin: 0; padding: 0; border: 0; display: flex; flex-direction: column; gap: 8px; }
  legend { padding: 0; margin-bottom: 8px; font-size: 13px; font-weight: 600; color: var(--muted); }
  .controls input { position: absolute; opacity: 0; pointer-events: none; }
  .seg { display: inline-flex; padding: 3px; border: 1px solid var(--line); border-radius: 11px; background: var(--surface); }
  .seg label { min-height: 36px; display: inline-flex; align-items: center; padding: 0 14px; border-radius: 8px; color: var(--muted); font-size: 14px; cursor: pointer; }
  .seg input:checked + label { background: var(--code-bg); color: var(--text); font-weight: 600; }
  .seg input:focus-visible + label { outline: 2px solid var(--link); }
  .swatches { display: flex; gap: 10px; min-height: 44px; align-items: center; }
  .swatches label { width: 28px; height: 28px; border-radius: 50%; background: var(--c); cursor: pointer; box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.15); }
  .swatches input:checked + label { box-shadow: 0 0 0 3px var(--bg), 0 0 0 5px var(--c); }
  .swatches input:focus-visible + label { outline: 2px solid var(--text); outline-offset: 5px; }

  .code {
    margin: 0;
    padding: 16px 18px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--code-bg);
    font-size: 13.5px;
    line-height: 1.55;
    overflow-x: auto;
  }

</style>
